# Stripe secret key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (from `stripe listen` locally, or the
# webhook endpoint you create in the Stripe Dashboard for production)
STRIPE_WEBHOOK_SECRET=

# Currency for bids — European startups, so EUR by default
STRIPE_CURRENCY=eur

# Vercel Blob read/write token — auto-set when you create a Blob store in
# the Vercel dashboard (Storage tab) and link it to this project. Only
# needed for the cheat-code side channel below; the site works without it.
BLOB_READ_WRITE_TOKEN=

# Secret suffix that skips Stripe and grants a free ("comped") leaderboard
# entry — e.g. with CHEAT_CODE=xyz123, typing "getfluida.com-xyz123" as the
# URL claims getfluida.com for free at whatever amount was entered. Keep
# this value out of git; pick something unguessable. Leave unset to disable
# the feature entirely.
CHEAT_CODE=
